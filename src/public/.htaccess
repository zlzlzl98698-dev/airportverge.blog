# ------------------------------------------------------------------------------
# Apache Configuration for airportverge.blog (VitePress Static Site)
# ------------------------------------------------------------------------------

# 1. 禁止目录索引浏览
Options -Indexes

# 2. 默认文档
DirectoryIndex index.html

# 3. 开启 URL 重写
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3.1 强制启用 HTTPS (可选，在反代或 SSL 开启时生效)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3.2 阻止访问敏感文件
  RewriteRule "(^|/)\.(?!well-known)" - [F]

  # 3.3 Clean URLs 支持 (访问 /about 时内部转到 /about.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 3.4 目录友好 URL (访问 /clash 自动定向到 /clash/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ $1/ [L,R=301]
</IfModule>

# 4. 自定义 404 错误页面 (返回正确 404 状态码，绝不伪装为 SPA 回退)
ErrorDocument 404 /404.html

# 5. 静态资源缓存策略
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML 页面短缓存/不缓存以保证即时更新
  ExpiresByType text/html "access plus 0 seconds"

  # CSS 和 JavaScript 长期缓存 (Vite 打包带哈希指纹)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # 图片与媒体资源
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"

  # 字体
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 6. 安全响应头
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # 针对 HTML 禁用缓存
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # 针对带哈希静态资源长缓存
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
